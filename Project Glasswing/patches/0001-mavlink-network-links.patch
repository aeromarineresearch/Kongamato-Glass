-    "smbus"
-
 ]
 
 [project.optional-dependencies]
@@ -65,6 +59,16 @@ build = [
 qt = [
     "PyQt6>=6.6.1",
 ]
+# Raspberry-Pi-only hardware plugins (GPIO/I2C). These are Linux/RPi-only
+# packages — keeping them in an extra lets the gateway install cleanly on
+# macOS/Windows dev machines (e.g. for SITL development).
+# You cannot install rpi-lgpio and rpi-gpio (aka RPi.GPIO, the library it emulates)
+# at the same time, in the same Python environment. Both packages attempt
+# to install a module named RPi.GPIO and obviously this will not work.
+rpi = [
+    "rpi-lgpio>=0.6",
+    "smbus",
+]
 
 [project.scripts]
 fixgw = "fixgw.server:main"
diff --git a/src/fixgw/plugins/mavlink/Mav.py b/src/fixgw/plugins/mavlink/Mav.py
index 0ee8c25..b7b1eca 100644
--- a/src/fixgw/plugins/mavlink/Mav.py
+++ b/src/fixgw/plugins/mavlink/Mav.py
@@ -83,22 +83,33 @@ class Mav:
         self._waypoint = str  # The current known waypoint
         self.setStat("ERROR", "No Communication")
 
-        if not stat(port):
-            self.setStat("ERROR", "No Communication")
-            raise Exception(f"serial port {port} is not found!")
-        # When using USB serial when flight computer boots it creates /dev/ttyASM0
-        # But then removes it and re-creates it again, we want to ensure we open the correct one so we wait and check again
-        time.sleep(5)
-        if not stat(port):
-            self.setStat("ERROR", "No Communication")
-            raise Exception(f"serial port {port} is not found!")
+        # pymavlink connection strings (e.g. "udp:127.0.0.1:14552",
+        # "tcp:127.0.0.1:5760", "udpin:0.0.0.0:14550") are network links,
+        # not serial device files — skip the device-file checks for those.
+        self._network_link = port.startswith(
+            ("udp:", "udpin:", "udpout:", "tcp:", "tcpin:", "tcpout:", "udp-bcast:")
+        )
+
+        if not self._network_link:
+            if not stat(port):
+                self.setStat("ERROR", "No Communication")
+                raise Exception(f"serial port {port} is not found!")
+            # When using USB serial when flight computer boots it creates /dev/ttyASM0
+            # But then removes it and re-creates it again, we want to ensure we open the correct one so we wait and check again
+            time.sleep(5)
+            if not stat(port):
+                self.setStat("ERROR", "No Communication")
+                raise Exception(f"serial port {port} is not found!")
 
         self._interval = defaultdict(lambda: 200000)
         self._data = defaultdict(list)
         self._max_average = 15
 
-        # Connect
-        self.conn = mavutil.mavlink_connection(port, baud=baud)
+        # Connect (baud is meaningless for network links)
+        if self._network_link:
+            self.conn = mavutil.mavlink_connection(port)
+        else:
+            self.conn = mavutil.mavlink_connection(port, baud=baud)
         self.ids = []
         self.ids.append(mavutil.mavlink.MAVLINK_MSG_ID_SERVO_OUTPUT_RAW)
         self._interval[mavutil.mavlink.MAVLINK_MSG_ID_SERVO_OUTPUT_RAW] = 400000
